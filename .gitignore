# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
out/

# production
build/

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env
.env.local
.env.*.local

# data (runtime) — the whole directory, not just the top-level db files.
# Backups live under here too and carry PIN hashes, so none of it ships.
data/

# The other place backups land: scripts that are about to change the database
# wholesale drop a copy here first. Same content as data/, same reason to keep
# it out — PIN hashes, customer names, every ticket the shop has rung.
backups/

# uploads (runtime)
uploads/

# TLS material. key.pem is a private key, and mkcert regenerates both locally,
# so there is nothing to gain by committing them and a lot to lose.
certs/

# Vendored 5 MB binary, not source.
mkcert.exe

# Per-machine Claude Code tool permissions. launch.json IS committed -- it
# describes how to run the project -- but this one is just local scratch.
.claude/settings.local.json

# logs
npm-debug.log*
*.log

# misc
.DS_Store
Thumbs.db

# Local scratch copies of the permissions file.
*.bak

# docs/ holds the four generated manuals, and those DO ship — a shop that needs
# to reprint the staff guide should not have to run a build to get it. What also
# lands in there is scratch: rendered close-outs from checking a print layout,
# and screenshots taken to verify a screen. Seven megabytes of that is not
# documentation, so the directory is excluded and the manuals are named back in.
docs/*
!docs/Manual-del-Reloj.html
!docs/Manual-del-Reloj.pdf
!docs/Manual-del-Sistema.html
# The sales brochure is written, not rendered, so the source is named back in
# like the manuals. Its PDF is NOT: `scripts/build-brochure.mjs` produces it
# from this file on demand, and a 600KB binary that a script rebuilds in eight
# seconds is a merge conflict waiting to happen rather than a document.
!docs/treadline-brochure.html
!docs/Manual-del-Sistema.pdf
!docs/Shop-System-Manual.html
!docs/Shop-System-Manual.pdf
!docs/Time-Clock-Manual.html
!docs/Time-Clock-Manual.pdf
