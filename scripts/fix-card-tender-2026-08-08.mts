/**
 * Put the register's card total back onto the terminal's, for 2026-08-08.
 *
 * The terminal batch for the day settled at $2,747.00 across 52 swipes. The
 * register held $2,860.00 of card payments. $12.00 of that gap is the tip on
 * S-2026-000229 taken at 17:36, seven minutes after the batch printed, so it
 * belongs to the next batch and is not an error. The remaining $101.00 is not
 * money missing from the terminal -- nothing can be taken out of a settled
 * batch -- it is $101.00 the register recorded on the card that the card never
 * ran. Reconciling the two lists by amount leaves exactly:
 *
 *     one $22 charge, one $45 charge, two $16 charges, and $2 on S-2026-000219.
 *
 * The $2 is exact. Swipe 46 ran $66.00 (auth 001953, card x4961) against a
 * ticket the register holds as $60.00 plus an $8.00 tip charge. The customer's
 * $6.00 tip WAS charged -- 60 + 6 = 66 -- and the $2.00 terminal fee on it was
 * recorded and never charged to the card. So the fee was not collected, and the
 * register has to say so. The technician's $6.00 tip is untouched.
 *
 * The other four cannot be identified from the data and this script does not
 * pretend otherwise. Those amounts repeat all day, the register's SEQ is
 * generated by `nextSeq` rather than typed off the terminal so it cannot be
 * matched against it, and the running totals never re-agree after swipe 10, so
 * there is no window to narrow it to. Four tickets are named below because the
 * shop's answer was that it does not matter which, only that none of them is an
 * order -- and none is. If a receipt later proves a different ticket was the
 * one, move it: the correction is a reversal plus a new row either way, and
 * nothing here is destroyed.
 *
 * They become CASH rather than being reversed as unpaid. These are $16 flats
 * that were fixed and driven away; the money came in, on the wrong button,
 * which is the commonest fault at this counter. Booking them to cash is also
 * the honest option for the drawer: it raises what the till was expected to
 * hold by $99.00 and turns an $84.00 shortfall into roughly $183.00, which is
 * the real hole. Reversing them instead would have hidden it.
 *
 * DRY RUN unless given --commit.
 */

import { getDb } from "../src/lib/db.ts";
import { inTx } from "../src/lib/tx.ts";
import { nowLocalIso } from "../src/lib/time.ts";
import { logActorAudit, type Actor } from "../src/lib/audit.ts";
import { addTipAdjustment, correctPayment } from "../src/lib/payments.ts";
import type { PosUser } from "../src/lib/pos-session.ts";

const commit = process.argv.includes("--commit");
const db = getDb();
const DATE = "2026-08-08";
const REASON =
  "Rung as card, never charged on the terminal — batch 1482 reconciliation";

const money = (c: number) => `$${(c / 100).toFixed(2)}`;

const owner = db
  .prepare("SELECT id, name FROM employees WHERE pos_role = 'owner' AND active = 1 ORDER BY id")
  .get() as { id: number; name: string } | undefined;
if (!owner) throw new Error("No active owner to attribute this to");
const user: PosUser = { employeeId: owner.id, name: owner.name, role: "owner" };
const actor: Actor = { type: "employee", employeeId: owner.id, name: owner.name, role: "owner" };

const cash = db.prepare("SELECT id FROM payment_methods WHERE code = 'cash'").get() as
  | { id: number }
  | undefined;
if (!cash) throw new Error("No cash tender");

const cardTotal = () =>
  (
    db
      .prepare(
        `SELECT COALESCE(SUM(p.amount_cents), 0) AS n FROM payments p
           JOIN sales s ON s.id = p.sale_id
           JOIN payment_methods m ON m.id = p.method_id
          WHERE s.business_date = ? AND m.is_card = 1 AND s.deleted = 0`,
      )
      .get(DATE) as { n: number }
  ).n;

console.log(commit ? "=== COMMIT ===" : "=== DRY RUN (pass --commit to apply) ===");
console.log(`attributed to ${owner.name}`);
console.log(`card total before: ${money(cardTotal())}\n`);

/** The four rung on the wrong button. Named, checked, and refused if an order. */
const WRONG_TENDER = ["S-2026-000209", "S-2026-000211", "S-2026-000214", "S-2026-000217"];

console.log("TENDER CORRECTIONS — Credit Card -> Cash");
for (const saleNo of WRONG_TENDER) {
  const row = db
    .prepare(
      `SELECT p.id, p.amount_cents AS cents, s.is_special_order AS so, s.status, s.sale_no AS sn
         FROM payments p JOIN sales s ON s.id = p.sale_id
         JOIN payment_methods m ON m.id = p.method_id
        WHERE s.sale_no = ? AND m.is_card = 1 AND p.kind = 'payment' AND s.deleted = 0`,
    )
    .get(saleNo) as { id: number; cents: number; so: number; status: string; sn: string } | undefined;

  if (!row) { console.log(`  ${saleNo}: no card payment found — skipped`); continue; }
  if (row.so) { console.log(`  ${saleNo}: IS A SPECIAL ORDER — skipped`); continue; }
  if (row.status !== "completed") { console.log(`  ${saleNo}: ${row.status} — skipped`); continue; }

  console.log(`  ${saleNo}  ${money(row.cents)}  card -> cash`);
  if (!commit) continue;
  const res = correctPayment(user, row.id, { methodId: cash.id, reason: REASON });
  if (!res.ok) console.log(`    FAILED: ${res.error}`);
}

/**
 * The $2, on S-2026-000219's tip adjustment.
 *
 * `correctPayment` refuses a tip adjustment on purpose, so this does what it
 * would have done: a reversal row pointing at the original, then a fresh
 * adjustment for the tip that was actually charged with the fee overridden to
 * nothing. The ledger stays append-only and the original row survives.
 */
console.log("\nTIP FEE NEVER CHARGED — S-2026-000219");
const tipRow = db
  .prepare(
    `SELECT p.* FROM payments p JOIN sales s ON s.id = p.sale_id
      WHERE s.sale_no = 'S-2026-000219' AND p.kind = 'tip_adjustment'
        AND NOT EXISTS (SELECT 1 FROM payments r WHERE r.reverses_payment_id = p.id)`,
  )
  .get() as
  | { id: number; sale_id: number; method_id: number; amount_cents: number; tip_cents: number;
      comm_cents: number; mechanic_id: number | null; business_date: string; shift_id: number | null }
  | undefined;

if (!tipRow) console.log("  nothing to correct (already done, or not found)");
else if (tipRow.amount_cents !== 800 || tipRow.comm_cents !== 200)
  console.log(`  expected $8.00 with a $2.00 fee, found ${money(tipRow.amount_cents)} with ${money(tipRow.comm_cents)} — skipped`);
else {
  console.log(`  ${money(tipRow.amount_cents)} (tip ${money(tipRow.tip_cents)} + fee ${money(tipRow.comm_cents)}) -> ${money(tipRow.tip_cents)} (fee not collected)`);
  if (commit)
    inTx(() => {
      db.prepare(
        `INSERT INTO payments
           (sale_id, method_id, kind, amount_cents, tip_cents, comm_cents,
            mechanic_id, reverses_payment_id, taken_by, business_date, shift_id, note, created_at)
         VALUES (?, ?, 'reversal', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      ).run(
        tipRow.sale_id, tipRow.method_id,
        -tipRow.amount_cents, -tipRow.tip_cents, -tipRow.comm_cents,
        tipRow.mechanic_id, tipRow.id, user.employeeId,
        tipRow.business_date, tipRow.shift_id,
        `Terminal fee never charged: ${REASON}`, nowLocalIso(),
      );
      logActorAudit(actor, {
        action: "payment.reversal",
        targetType: "payment",
        targetId: tipRow.id,
        details: { reason: "Terminal ran $66.00; the $2.00 tip fee was recorded but not charged" },
        before: { amount_cents: tipRow.amount_cents, comm_cents: tipRow.comm_cents },
        after: { amount_cents: 0, comm_cents: 0 },
      });

      const re = addTipAdjustment(user, tipRow.sale_id, {
        methodId: tipRow.method_id,
        tipCents: tipRow.tip_cents,
        mechanicId: tipRow.mechanic_id,
        commCentsOverride: 0,
        note: "Re-recorded at what the terminal actually charged",
      });
      if (!re.ok) throw new Error(`tip re-add failed: ${re.error}`);
    });
}

console.log(`\ncard total after: ${money(cardTotal())}`);
console.log("terminal batch 1482: $2747.00  ·  plus the 17:36 tip $12.00 = $2759.00");
if (!commit) console.log("\nNothing written. Re-run with --commit.");
